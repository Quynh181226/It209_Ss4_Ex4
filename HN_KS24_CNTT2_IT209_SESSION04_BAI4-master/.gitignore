# ==============================================
# .gitignore - Cau hinh bo qua file cho Git
# ==============================================

# --- File bao mat / Credentials ---
credentials.txt
*.env
.env
.env.*
*.pem
*.key
*.p12
secrets.txt
config/secrets.yml

# --- Thu muc build cua Java / Maven / Gradle ---
target/
build/
out/
*.class
*.jar
*.war
*.ear
*.nar

# --- IDE va Editor ---
.idea/
*.iml
.eclipse/
.settings/
.project
.classpath
*.sublime-workspace
.vscode/

# --- He dieu hanh ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# --- Log files ---
*.log
logs/

# --- Thu muc phu thuoc ---
node_modules/
vendor/
